      </div>

      <!-- 現在の刻み幅 h -->
      <div class="bg-space-900 border border-slate-800/90 rounded-xl px-2.5 py-1.5 flex flex-col justify-between">
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] sm:text-[11px] text-slate-400">現在の刻み幅 <i class="font-serif">h</i></span>
          <span id="stat-order-tag" class="text-[9px] font-mono px-1 rounded bg-slate-800 text-amber-300">p=5</span>
        </div>
        <div id="stat-dt" class="font-mono text-sm sm:text-base font-bold text-amber-300 mt-0.5">1.00e-3</div>
      </div>

