        <!-- 時刻ジャンプ -->
        <div class="sm:col-span-7 flex items-center gap-1.5 overflow-x-auto pb-0.5">
          <span class="text-[11px] text-slate-400 shrink-0 font-medium">時刻ジャンプ:</span>
          <button type="button" data-jump="15.8"
            class="btn-jump shrink-0 text-[11px] font-mono px-2 py-1 rounded-lg bg-slate-800/90 hover:bg-slate-700 active:scale-95 text-sky-300 border border-slate-700/80 transition">
