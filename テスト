          bs23:     { id: 'bs23',     order: 3,  short: '3次 BS23',       name: '3次: Bogacki-Shampine 3(2) [BS23]',       type: '埋込型RK / FSAL 適応刻み', adaptive: true },
          yoshida4: { id: 'yoshida4', order: 4,  short: '4次 Yoshida',    name: '4次: Yoshida 4th Symplectic (吉田4次)',    type: '固定刻み / 3重合成 (h=8e-4)', adaptive: false, fixedDt: 8e-4 },
          dopri5:   { id: 'dopri5',   order: 5,  short: '5次 DOPRI5',     name: '5次: Dormand-Prince 5(4) [DOPRI5]',       type: '埋込型RK / FSAL 適応刻み', adaptive: true },
          dverk6:   { id: 'dverk6',   order: 6,  short: '6次 Verner6(5)', name: '6次: Verner 6(5) [DVERK]',                type: '8段埋込型RK / 適応刻み', adaptive: true },
          rkf78:    { id: 'rkf78',    order: 7,  short: '7次 RKF78',      name: '7次: Fehlberg 7(8) [RKF78]',              type: '13段埋込型RK / 適応刻み', adaptive: true },
          dop853:   { id: 'dop853',   order: 8,  short: '8次 DOP853',     name: '8次: Dormand-Prince 8(5,3) [DOP853]',     type: '12段埋込型RK / 適応刻み', adaptive: true },
          gl10:     { id: 'gl10',     order: 10, short: '10次 GL10陰的',  name: '10次: Gauss-Legendre 5段陰的RK [GL10]',   type: '5段陰的シンプレクティック', adaptive: true },
          gbs13:    { id: 'gbs13',    order: 13, short: '13次 GBS-13',    name: '13次: Gragg-Bulirsch-Stoer外挿法 [GBS-13]', type: '修正中点+多項式外挿 (最高13次)', adaptive: true }
        };

        // ==========================================
        // 3. 汎用埋込型ルンゲ・クッタ係数テーブル (BS23, DOPRI5, DVERK6, RKF78, DOP853)
        // ==========================================
        // 3次: Bogacki-Shampine 3(2) (4段, FSAL)
        const TABLE_BS23 = {
          s: 4, p: 3, fsal: true,
          a: [
            [],
            [1/2],
