            0.0, 0.0, 0.0, 0.0,
            0.445031289275240888144113950566e+1 - (-0.1225156446376204440720569753e+1),
            0.189151789931450038304281599044e+1 - (-0.4957589496572501915214079952e+0),
            -0.580120396001058478146721142270e+1 - 0.1664377182454986536961530415e+1,
            0.311164366957819894408916062370e+0 - (-0.3503288487499736816886487290e+0),
            -0.152160949662516078556178806805e+0 - 0.3341791187130174790297318841e+0,
            0.201365400804030348374776537501e+0 - 0.8192320648511571246570742613e-1,
            0.447106157277725905176885569043e-1 - (-0.2235530786388629525884427845e-1)
          ]
        };

        const RK_TABLES = {
          bs23: TABLE_BS23,
          dopri5: TABLE_DOPRI5,
          dverk6: TABLE_DVERK6,
          rkf78: TABLE_RKF78,
          dop853: TABLE_DOP853
        };

        // ==========================================
        // 4. 10次 Gauss-Legendre 5段陰的ルンゲ・クッタ係数 (Order 2s = 10)
        // ==========================================
        // 5次ルジャンドル多項式 P5(2c-1)=0 の厳密な求積点 c_i と重み b_i
        const GL10_C = [
          0.5 - Math.sqrt(245 + 14 * Math.sqrt(70)) / 42,
          0.5 - Math.sqrt(245 - 14 * Math.sqrt(70)) / 42,
          0.5,
          0.5 + Math.sqrt(245 - 14 * Math.sqrt(70)) / 42,
          0.5 + Math.sqrt(245 + 14 * Math.sqrt(70)) / 42
        ];
        const GL10_B = [
          (322 - 13 * Math.sqrt(70)) / 1800,
          (322 + 13 * Math.sqrt(70)) / 1800,
          64 / 225,
          (322 + 13 * Math.sqrt(70)) / 1800,
          (322 - 13 * Math.sqrt(70)) / 1800
        ];
        // コロケーション条件 a_{ij} = \int_0^{c_i} L_j(tau) dtau を数値積分(ガウス求積)で機械精度構築
        const GL10_A = (() => {
          const A = Array.from({ length: 5 }, () => new Float64Array(5));
          for (let i = 0; i < 5; i++) {
            const ci = GL10_C[i];
            for (let j = 0; j < 5; j++) {
              // [0, ci] 上の 5点ガウス・ルジャンドル求積で 4次ラグランジュ基底多項式 L_j(t) を厳密積分
              let sum = 0.0;
              for (let q = 0; q < 5; q++) {
                const t = ci * GL10_C[q];
                let lj = 1.0;
                for (let m = 0; m < 5; m++) {
                  if (m !== j) lj *= (t - GL10_C[m]) / (GL10_C[j] - GL10_C[m]);
                }
                sum += GL10_B[q] * lj;
              }
              A[i][j] = ci * sum;
            }
          }
          return A;
        })();

        // ==========================================
        // 5. ソルバ状態クラス（メイン画面とベンチマークで独立インスタンス化可能）
        // ==========================================
        function createSolverSession(schemeId, tolVal) {
          return {
            schemeId,
            tol: tolVal,
            state: getInitialState(),
            simTime: 0.0,
            dt: SCHEMES[schemeId].adaptive ? 1e-3 : SCHEMES[schemeId].fixedDt,
            acceptedSteps: 0,
            rejectedSteps: 0,
            // FSAL用キャッシュ
            hasCachedDeriv: false,
            cachedDeriv: new Float64Array(12),
            cachedAcc: new Float64Array(6),
            // RK作業バッファ (最大13段)
            K: Array.from({ length: 13 }, () => new Float64Array(12)),
            yTemp: new Float64Array(12),
            yNext: new Float64Array(12),
            yHalf: new Float64Array(12),
            acc1: new Float64Array(6),
            acc2: new Float64Array(6),
            // 陰的RK用ステージバッファ
            Z: Array.from({ length: 5 }, () => new Float64Array(12)),
            KZ: Array.from({ length: 5 }, () => new Float64Array(12)),
            // GBS-13外挿用バッファ
            gbsSeq: [2, 4, 6, 8, 12, 16],
            gbsTableau: Array.from({ length: 6 }, () => new Float64Array(12)),
            gbsY0: new Float64Array(12),
            gbsY1: new Float64Array(12),
            gbsY2: new Float64Array(12),
            gbsDydt: new Float64Array(12)
          };
        }

        // ==========================================
        // 6. 各積分スキームの 1ステップ前進実装
        // ==========================================

        /**
         * 1次: Forward Euler
         */
        function stepEuler1(sess, maxLimit) {
          const h = Math.min(SCHEMES.euler1.fixedDt, maxLimit);
          computeDerivatives(sess.state, sess.K[0]);
          for (let i = 0; i < 12; i++) {
            sess.state[i] += h * sess.K[0][i];
          }
          sess.dt = h;
          sess.simTime += h;
          sess.acceptedSteps++;
          return h;
        }

        /**
         * 2次: Velocity Verlet (FSAL)
         */
        function stepVerlet2(sess, maxLimit) {
          const h = Math.min(SCHEMES.verlet2.fixedDt, maxLimit);
          const y = sess.state;
          if (!sess.hasCachedDeriv) {
            computeAccelerationsOnly(y, sess.cachedAcc);
            sess.hasCachedDeriv = true;
          }
          const a = sess.cachedAcc;
          const halfH = 0.5 * h;
          const halfH2 = 0.5 * h * h;

          // 位置更新 r(t+h) = r(t) + v(t)h + 0.5 a(t)h^2
          for (let i = 0; i < 6; i++) {
            y[i] += y[i + 6] * h + a[i] * halfH2;
          }
          // 新位置で加速度評価 a(t+h)
          computeAccelerationsOnly(y, sess.acc1);
          // 速度更新 v(t+h) = v(t) + 0.5 (a(t) + a(t+h)) h
          for (let i = 0; i < 6; i++) {
            y[i + 6] += (a[i] + sess.acc1[i]) * halfH;
          }
          sess.cachedAcc.set(sess.acc1);
          sess.dt = h;
          sess.simTime += h;
          sess.acceptedSteps++;
          return h;
        }

        /**
         * 4次: Yoshida 4th-Order Symplectic (3重リープフロッグ合成)
         */
        const YOSHIDA_CBRT2 = Math.cbrt(2.0);
        const YOSHIDA_W1 = 1.0 / (2.0 - YOSHIDA_CBRT2);
        const YOSHIDA_W0 = -YOSHIDA_CBRT2 / (2.0 - YOSHIDA_CBRT2);
        const YOSHIDA_C = [
          0.5 * YOSHIDA_W1,
          0.5 * (YOSHIDA_W1 + YOSHIDA_W0),
          0.5 * (YOSHIDA_W0 + YOSHIDA_W1),
          0.5 * YOSHIDA_W1
        ];
        const YOSHIDA_D = [YOSHIDA_W1, YOSHIDA_W0, YOSHIDA_W1];

        function stepYoshida4(sess, maxLimit) {
          const h = Math.min(SCHEMES.yoshida4.fixedDt, maxLimit);
          const y = sess.state;
          const acc = sess.acc1;

          // Drift 1
          for (let i = 0; i < 6; i++) y[i] += YOSHIDA_C[0] * h * y[i + 6];
          // Kick 1
          computeAccelerationsOnly(y, acc);
          for (let i = 0; i < 6; i++) y[i + 6] += YOSHIDA_D[0] * h * acc[i];

          // Drift 2
          for (let i = 0; i < 6; i++) y[i] += YOSHIDA_C[1] * h * y[i + 6];
          // Kick 2
          computeAccelerationsOnly(y, acc);
          for (let i = 0; i < 6; i++) y[i + 6] += YOSHIDA_D[1] * h * acc[i];

          // Drift 3
          for (let i = 0; i < 6; i++) y[i] += YOSHIDA_C[2] * h * y[i + 6];
          // Kick 3
          computeAccelerationsOnly(y, acc);
          for (let i = 0; i < 6; i++) y[i + 6] += YOSHIDA_D[2] * h * acc[i];

          // Drift 4
          for (let i = 0; i < 6; i++) y[i] += YOSHIDA_C[3] * h * y[i + 6];

          sess.dt = h;
          sess.simTime += h;
          sess.acceptedSteps++;
          return h;
        }

        /**
         * 汎用埋込型ルンゲ・クッタ 1ステップ (3次 BS23, 5次 DOPRI5, 6次 DVERK6, 7次 RKF78, 8次 DOP853)
         */
        function stepEmbeddedRK(sess, table, maxLimit) {
          const fac = 0.9;
          const facMin = 0.2;
          const facMax = 5.0;
          const hMin = 1e-14;
          const s = table.s;
          const expOrder = 1.0 / (table.p);

          if (table.fsal && !sess.hasCachedDeriv) {
            computeDerivatives(sess.state, sess.K[0]);
            sess.hasCachedDeriv = true;
          }

          let guard = 0;
          while (guard++ < 400) {
            let h = Math.min(sess.dt, maxLimit);
            if (h < hMin) h = hMin;

            if (!table.fsal) {
              computeDerivatives(sess.state, sess.K[0]);
            }

            // Stage 2 .. s
            for (let stage = 1; stage < s; stage++) {
              const aRow = table.a[stage];
              for (let i = 0; i < 12; i++) {
                let sum = 0.0;
                for (let j = 0; j < stage; j++) {
                  const aij = aRow[j];
                  if (aij !== 0.0) sum += aij * sess.K[j][i];
                }
                sess.yTemp[i] = sess.state[i] + h * sum;
              }
              computeDerivatives(sess.yTemp, sess.K[stage]);
            }

            // 高次主解 yNext の合成
            for (let i = 0; i < 12; i++) {
              let sum = 0.0;
              for (let j = 0; j < s; j++) {
                const bj = table.b[j];
                if (bj !== 0.0) sum += bj * sess.K[j][i];
              }
              sess.yNext[i] = sess.state[i] + h * sum;
            }

            // 誤差ノルム評価
            let errSqSum = 0.0;
            for (let i = 0; i < 12; i++) {
              let errSum = 0.0;
              for (let j = 0; j < s; j++) {
                const ej = table.e[j];
                if (ej !== 0.0) errSum += ej * sess.K[j][i];
              }
              const errComp = h * errSum;
              const scale = sess.tol + sess.tol * Math.max(Math.abs(sess.state[i]), Math.abs(sess.yNext[i]));
              const ratio = errComp / scale;
              errSqSum += ratio * ratio;
            }
            const errNorm = Math.sqrt(errSqSum / 12.0);

            let factor = errNorm === 0.0 ? facMax : fac * Math.pow(1.0 / errNorm, expOrder);
            factor = Math.min(facMax, Math.max(facMin, factor));

            if (errNorm <= 1.0 || h <= hMin) {
              sess.state.set(sess.yNext);
              if (table.fsal) {
                sess.K[0].set(sess.K[s - 1]);
              }
              sess.simTime += h;
              sess.acceptedSteps++;
              if (h === sess.dt || factor < 1.0) {
                sess.dt = h * factor;
              }
              return h;
            } else {
              sess.rejectedSteps++;
              sess.dt = h * Math.min(1.0, factor);
            }
          }
          return 0.0;
        }

        /**
         * 10次: 5段 Gauss-Legendre 陰的ルンゲ・クッタ法 (Order 10)
         * 単一ステップ(h) と 半分刻み2ステップ(h/2 + h/2) のリチャードソン外挿/誤差推定により適応制御
         */
        function gl10SingleStep(yIn, h, yOut, Z, KZ, iterTol) {
          computeDerivatives(yIn, KZ[0]);
          // 初期予測 Z_i = yIn + h * c_i * f(yIn)
          for (let s = 0; s < 5; s++) {
            const hc = h * GL10_C[s];
            for (let i = 0; i < 12; i++) {
              Z[s][i] = yIn[i] + hc * KZ[0][i];
            }
          }

          let converged = false;
          for (let iter = 0; iter < 18; iter++) {
            for (let s = 0; s < 5; s++) {
              computeDerivatives(Z[s], KZ[s]);
            }
            let maxDiff = 0.0;
            for (let s = 0; s < 5; s++) {
              const aRow = GL10_A[s];
              for (let i = 0; i < 12; i++) {
                const newVal = yIn[i] + h * (
                  aRow[0] * KZ[0][i] + aRow[1] * KZ[1][i] + aRow[2] * KZ[2][i] + aRow[3] * KZ[3][i] + aRow[4] * KZ[4][i]
                );
                const diff = Math.abs(newVal - Z[s][i]) / (1.0 + Math.abs(newVal));
                if (diff > maxDiff) maxDiff = diff;
                Z[s][i] = newVal;
              }
            }
            if (maxDiff < iterTol) {
              converged = true;
              break;
            }
          }

          // 最終ステージ導関数評価
          for (let s = 0; s < 5; s++) {
            computeDerivatives(Z[s], KZ[s]);
          }
          for (let i = 0; i < 12; i++) {
            yOut[i] = yIn[i] + h * (
              GL10_B[0] * KZ[0][i] + GL10_B[1] * KZ[1][i] + GL10_B[2] * KZ[2][i] + GL10_B[3] * KZ[3][i] + GL10_B[4] * KZ[4][i]
            );
          }
          return converged;
        }

        function stepGL10(sess, maxLimit) {
          const hMin = 1e-13;
          const iterTol = Math.min(1e-14, sess.tol * 0.01);
          let guard = 0;

          while (guard++ < 200) {
            let h = Math.min(sess.dt, maxLimit);
            if (h < hMin) h = hMin;

            const okFull = gl10SingleStep(sess.state, h, sess.yTemp, sess.Z, sess.KZ, iterTol);
            if (!okFull && h > hMin) {
              sess.rejectedSteps++;
              sess.dt = h * 0.4;
              continue;
            }

            // ステップ倍加（h/2 を2回）による10次誤差推定
            const halfH = 0.5 * h;
            const okH1 = gl10SingleStep(sess.state, halfH, sess.yHalf, sess.Z, sess.KZ, iterTol);
            const okH2 = okH1 ? gl10SingleStep(sess.yHalf, halfH, sess.yNext, sess.Z, sess.KZ, iterTol) : false;

            if ((!okH1 || !okH2) && h > hMin) {
              sess.rejectedSteps++;
              sess.dt = h * 0.4;
              continue;
            }

            // 10次誤差ノルム: (yNext - yTemp) / (2^10 - 1)
            let errSqSum = 0.0;
            const denom = 1023.0; // 2^10 - 1
            for (let i = 0; i < 12; i++) {
              const errComp = (sess.yNext[i] - sess.yTemp[i]) / denom;
              const scale = sess.tol + sess.tol * Math.max(Math.abs(sess.state[i]), Math.abs(sess.yNext[i]));
              const ratio = errComp / scale;
              errSqSum += ratio * ratio;
            }
            const errNorm = Math.sqrt(errSqSum / 12.0);

            let factor = errNorm === 0.0 ? 3.0 : 0.9 * Math.pow(1.0 / errNorm, 1.0 / 11.0);
            factor = Math.min(3.0, Math.max(0.25, factor));

            if (errNorm <= 1.0 || h <= hMin) {
              // 局所外挿 (11次精度相当の補正値) を採用
              for (let i = 0; i < 12; i++) {
                sess.state[i] = sess.yNext[i] + (sess.yNext[i] - sess.yTemp[i]) / denom;
              }
              sess.simTime += h;
              sess.acceptedSteps++;
              if (h === sess.dt || factor < 1.0) {
                sess.dt = h * factor;
              }
              return h;
            } else {
              sess.rejectedSteps++;
              sess.dt = h * Math.min(1.0, factor);
            }
          }
          return 0.0;
        }

        /**
         * 13次: Gragg-Bulirsch-Stoer (GBS-13) 外挿法
         * Graggの修正中点法 + Neville-Aitken 多項式外挿 (k=0..5 -> 次数 2k+1 = 1, 3, 5, 7, 9, 11 -> 外挿完了で13次精度)
         */
        function modifiedMidpoint(yStart, fStart, H, nSub, yOut, y0, y1, y2, dydt) {
          const h = H / nSub;
          const h2 = 2.0 * h;

          y0.set(yStart);
          for (let i = 0; i < 12; i++) {
            y1[i] = y0[i] + h * fStart[i];
          }

          for (let m = 1; m < nSub; m++) {
            computeDerivatives(y1, dydt);
            for (let i = 0; i < 12; i++) {
              y2[i] = y0[i] + h2 * dydt[i];
            }
            y0.set(y1);
            y1.set(y2);
          }

          // Graggの平滑化最終段
          computeDerivatives(y1, dydt);
          for (let i = 0; i < 12; i++) {
            yOut[i] = 0.5 * (y0[i] + y1[i] + h * dydt[i]);
          }
        }

        function stepGBS13(sess, maxLimit) {
          const hMin = 1e-13;
          const kMax = 6; // n_j = 2, 4, 6, 8, 12, 16 (6列外挿で最大13次精度)
          const seq = sess.gbsSeq;
          const T = sess.gbsTableau;

          computeDerivatives(sess.state, sess.K[0]);

          let guard = 0;
          while (guard++ < 250) {
            let H = Math.min(sess.dt, maxLimit);
            if (H < hMin) H = hMin;

            let accepted = false;
            let usedK = 0;
            let lastErrNorm = 1.0;

            for (let k = 0; k < kMax; k++) {
              // T[k] に分割数 seq[k] の修正中点結果を格納
              modifiedMidpoint(
                sess.state, sess.K[0], H, seq[k],
                T[k], sess.gbsY0, sess.gbsY1, sess.gbsY2, sess.gbsDydt
              );

              // Neville-Aitken 多項式外挿 (h^2 についての外挿)
              for (let j = k - 1; j >= 0; j--) {
                const ratioSq = (seq[k] / seq[j]) * (seq[k] / seq[j]);
                const invDenom = 1.0 / (ratioSq - 1.0);
                for (let i = 0; i < 12; i++) {
                  T[j][i] = T[j + 1][i] + (T[j + 1][i] - T[j][i]) * invDenom;
                }
              }

              if (k >= 1) {
                // T[0] (最高次外挿値) と T[1] (1つ低次の外挿値) の差で誤差判定
                let errSqSum = 0.0;
                for (let i = 0; i < 12; i++) {
                  const errComp = Math.abs(T[0][i] - T[1][i]);
                  const scale = sess.tol + sess.tol * Math.max(Math.abs(sess.state[i]), Math.abs(T[0][i]));
                  const r = errComp / scale;
                  errSqSum += r * r;
                }
                lastErrNorm = Math.sqrt(errSqSum / 12.0);
                usedK = k;

                if (lastErrNorm <= 1.0) {
                  accepted = true;
                  break;
                }
              }
            }

            if (accepted || H <= hMin) {
              sess.state.set(T[0]);
              sess.simTime += H;
              sess.acceptedSteps++;

              const orderEst = 2 * usedK + 1;
              let factor = lastErrNorm === 0.0 ? 2.5 : 0.9 * Math.pow(1.0 / lastErrNorm, 1.0 / orderEst);
              factor = Math.min(2.5, Math.max(0.25, factor));

              // 少ない段数(k <= 3)で収束した場合は刻み幅を積極拡大し NFE を劇的に削減
              if (usedK <= 3 && factor > 1.0) {
                factor = Math.min(2.8, factor * 1.15);
              }
              if (H === sess.dt || factor < 1.0) {
                sess.dt = H * factor;
              }
              return H;
            } else {
              sess.rejectedSteps++;
              sess.dt = H * 0.45;
            }
          }
          return 0.0;
        }

        /**
         * セッションのスキームに応じた1ステップディスパッチャ
         */
        function stepSession(sess, maxLimit) {
          switch (sess.schemeId) {
            case 'euler1':   return stepEuler1(sess, maxLimit);
            case 'verlet2':  return stepVerlet2(sess, maxLimit);
            case 'yoshida4': return stepYoshida4(sess, maxLimit);
            case 'bs23':
            case 'dopri5':
            case 'dverk6':
            case 'rkf78':
            case 'dop853':
              return stepEmbeddedRK(sess, RK_TABLES[sess.schemeId], maxLimit);
            case 'gl10':     return stepGL10(sess, maxLimit);
            case 'gbs13':    return stepGBS13(sess, maxLimit);
            default:
              return stepEmbeddedRK(sess, TABLE_DOPRI5, maxLimit);
          }
        }

        // ==========================================
        // 7. メイン画面のシミュレーション状態管理
        // ==========================================
        let mainSession = createSolverSession('dopri5', 1e-11);
        let trails = [[], [], []];
        let fullTrailMode = true;
        const SHORT_TRAIL_MAX = 500;

        let isRunning = true;
        let speedPerFrame = 0.100;
        let autoZoom = true;

        const view = {
          centerX: 0.0,
          centerY: 0.4,
          scale: 52.0
        };

        function recordTrailPoint() {
          for (let b = 0; b < 3; b++) {
            const x = mainSession.state[b * 2];
            const y = mainSession.state[b * 2 + 1];
            const arr = trails[b];
            if (arr.length > 0) {
              const last = arr[arr.length - 1];
              const distSq = (x - last.x) * (x - last.x) + (y - last.y) * (y - last.y);
              if (distSq < 1e-5) continue;
            }
            arr.push({ x, y });
            if (!fullTrailMode && arr.length > SHORT_TRAIL_MAX) {
              arr.shift();
            }
          }
        }

        function updateAutoCamera(instant = false) {
          if (!autoZoom || cssWidth === 0 || cssHeight === 0) return;

          let minX = -2.5, maxX = 2.5;
          let minY = -2.0, maxY = 3.2;

          for (let b = 0; b < 3; b++) {
            const x = mainSession.state[b * 2];
            const y = mainSession.state[b * 2 + 1];
            if (Number.isFinite(x) && Number.isFinite(y)) {
              if (x < minX) minX = x;
              if (x > maxX) maxX = x;
              if (y < minY) minY = y;
              if (y > maxY) maxY = y;
            }
          }

          const spanX = Math.min(500, (maxX - minX) * 1.32);
          const spanY = Math.min(500, (maxY - minY) * 1.32);
          const targetScale = Math.max(2.0, Math.min(cssWidth / spanX, cssHeight / spanY));
          const targetCenterX = (minX + maxX) * 0.5;
          const targetCenterY = (minY + maxY) * 0.5;

          const lerp = instant ? 1.0 : 0.15;
          view.scale += (targetScale - view.scale) * lerp;
          view.centerX += (targetCenterX - view.centerX) * lerp;
          view.centerY += (targetCenterY - view.centerY) * lerp;
        }

        // ==========================================
        // 8. Canvas 描画処理
        // ==========================================
        const canvas = document.getElementById('sim-canvas');
        const ctx = canvas.getContext('2d');
        let cssWidth = 0;
        let cssHeight = 0;

        function resizeCanvas() {
          const rect = canvas.parentElement.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
          cssWidth = rect.width;
          cssHeight = rect.height;
          canvas.width = Math.round(cssWidth * dpr);
          canvas.height = Math.round(cssHeight * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          render();
        }

        function worldToScreen(wx, wy) {
          return {
            x: cssWidth * 0.5 + (wx - view.centerX) * view.scale,
            y: cssHeight * 0.5 - (wy - view.centerY) * view.scale
          };
        }

        function render() {
          if (cssWidth === 0 || cssHeight === 0) return;

          ctx.fillStyle = '#050811';
          ctx.fillRect(0, 0, cssWidth, cssHeight);

          drawGrid();

          // 重心 (0,0) クロスヘア
          const origin = worldToScreen(0, 0);
          ctx.strokeStyle = 'rgba(148, 163, 184, 0.35)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(origin.x - 8, origin.y);
          ctx.lineTo(origin.x + 8, origin.y);
          ctx.moveTo(origin.x, origin.y - 8);
          ctx.lineTo(origin.x, origin.y + 8);
          ctx.stroke();

          // 初期三角形ガイド
          const p1 = worldToScreen(1, 3);
          const p2 = worldToScreen(-2, -1);
          const p3 = worldToScreen(1, -1);
          ctx.save();
          ctx.setLineDash([4, 4]);
          ctx.strokeStyle = 'rgba(148, 163, 184, 0.16)';
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.lineTo(p3.x, p3.y);
          ctx.closePath();
          ctx.stroke();
          ctx.restore();

          // 軌跡描画
          for (let b = 0; b < 3; b++) {
            const pts = trails[b];
            if (pts.length < 2) continue;

            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            if (fullTrailMode) {
              ctx.beginPath();
              const p0 = worldToScreen(pts[0].x, pts[0].y);
              ctx.moveTo(p0.x, p0.y);
              for (let i = 1; i < pts.length; i++) {
                const p = worldToScreen(pts[i].x, pts[i].y);
                ctx.lineTo(p.x, p.y);
              }
              ctx.strokeStyle = BODY_COLORS[b] + '99';
              ctx.lineWidth = 1.6;
              ctx.stroke();
            } else {
              const len = pts.length;
              const chunk = 16;
              for (let start = 0; start < len - 1; start += chunk) {
                const end = Math.min(len - 1, start + chunk);
                const alpha = Math.max(0.08, (end / len) * 0.9);
                ctx.beginPath();
                const ps = worldToScreen(pts[start].x, pts[start].y);
                ctx.moveTo(ps.x, ps.y);
                for (let i = start + 1; i <= end; i++) {
                  const p = worldToScreen(pts[i].x, pts[i].y);
                  ctx.lineTo(p.x, p.y);
                }
                ctx.strokeStyle = hexToRgba(BODY_COLORS[b], alpha);
                ctx.lineWidth = 1.2 + (end / len) * 1.4;
                ctx.stroke();
              }
            }
          }

          // 3質点描画
          for (let b = 0; b < 3; b++) {
            const wx = mainSession.state[b * 2];
            const wy = mainSession.state[b * 2 + 1];
            if (!Number.isFinite(wx) || !Number.isFinite(wy)) continue;
            const pos = worldToScreen(wx, wy);
            const radius = 3.8 + Math.sqrt(MASSES[b]) * 2.2;

            const grad = ctx.createRadialGradient(pos.x, pos.y, radius * 0.2, pos.x, pos.y, radius * 2.6);
            grad.addColorStop(0, hexToRgba(BODY_COLORS[b], 0.55));
            grad.addColorStop(1, hexToRgba(BODY_COLORS[b], 0.0));
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(pos.x, pos.y, radius * 2.6, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = BODY_COLORS[b];
            ctx.beginPath();
            ctx.arc(pos.x, pos.y, radius, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.1;
            ctx.stroke();

            ctx.fillStyle = '#f8fafc';
            ctx.font = '600 10px "JetBrains Mono", monospace';
            ctx.fillText(`m${b + 1}`, pos.x + radius + 4, pos.y + 3);
          }
        }

        function drawGrid() {
          let step = 1.0;
          if (view.scale < 12) step = 10.0;
          else if (view.scale < 22) step = 5.0;
          else if (view.scale < 35) step = 2.0;
          else if (view.scale > 140) step = 0.5;

          const leftWorld = view.centerX - (cssWidth * 0.5) / view.scale;
          const rightWorld = view.centerX + (cssWidth * 0.5) / view.scale;
          const bottomWorld = view.centerY - (cssHeight * 0.5) / view.scale;
          const topWorld = view.centerY + (cssHeight * 0.5) / view.scale;

          const startX = Math.floor(leftWorld / step) * step;
          const startY = Math.floor(bottomWorld / step) * step;

          ctx.lineWidth = 1;
          for (let gx = startX; gx <= rightWorld; gx += step) {
            const sx = worldToScreen(gx, 0).x;
            const isAxis = Math.abs(gx) < 1e-6;
            ctx.strokeStyle = isAxis ? 'rgba(56, 189, 248, 0.2)' : 'rgba(28, 39, 69, 0.45)';
            ctx.beginPath();
            ctx.moveTo(sx, 0);
            ctx.lineTo(sx, cssHeight);
            ctx.stroke();
          }

          for (let gy = startY; gy <= topWorld; gy += step) {
            const sy = worldToScreen(0, gy).y;
            const isAxis = Math.abs(gy) < 1e-6;
            ctx.strokeStyle = isAxis ? 'rgba(56, 189, 248, 0.2)' : 'rgba(28, 39, 69, 0.45)';
            ctx.beginPath();
            ctx.moveTo(0, sy);
            ctx.lineTo(cssWidth, sy);
            ctx.stroke();
          }
        }

        function hexToRgba(hex, alpha) {
          const r = parseInt(hex.slice(1, 3), 16);
          const g = parseInt(hex.slice(3, 5), 16);
          const b = parseInt(hex.slice(5, 7), 16);
          return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        }

        // ==========================================
        // 9. テレメトリ更新
        // ==========================================
        const elTime = document.getElementById('stat-time');
        const elNfe = document.getElementById('stat-nfe');
        const elNfeRate = document.getElementById('stat-nfe-rate');
        const elDt = document.getElementById('stat-dt');
        const elOrderTag = document.getElementById('stat-order-tag');
        const elAccepted = document.getElementById('stat-accepted');
        const elRejected = document.getElementById('stat-rejected');
        const elEnergyErr = document.getElementById('stat-energy-err');
        const elTotalEnergy = document.getElementById('stat-total-energy');
        const elEventBadge = document.getElementById('event-badge');

        function updateTelemetry() {
          const meta = SCHEMES[mainSession.schemeId];
          elTime.textContent = mainSession.simTime.toFixed(3);
          elNfe.textContent = nfeCount.toLocaleString();
          const rate = mainSession.simTime > 1e-4 ? Math.round(nfeCount / mainSession.simTime) : 0;
          elNfeRate.textContent = `${rate.toLocaleString()} /t`;

          elDt.textContent = mainSession.dt.toExponential(2);
          elOrderTag.textContent = `p=${meta.order}`;
          elAccepted.textContent = mainSession.acceptedSteps.toLocaleString();
          elRejected.textContent = mainSession.rejectedSteps.toLocaleString();

          const currE = computeTotalEnergy(mainSession.state);
          const relErr = Math.abs(currE - E0) / Math.abs(E0);
          elEnergyErr.textContent = Number.isFinite(relErr) ? relErr.toExponential(2) : '発散 (NaN)';
          elTotalEnergy.textContent = Number.isFinite(currE) ? currE.toFixed(6) : 'NaN';

          if (!Number.isFinite(currE) || relErr > 0.05) {
            elEventBadge.textContent = '精度破綻・誤差増大';
            elEventBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-rose-500/25 text-rose-300 font-medium truncate';
          } else if (!isRunning && mainSession.simTime < 0.001) {
            elEventBadge.textContent = '初期状態 (3:4:5)';
            elEventBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-sky-500/15 text-sky-300 font-medium truncate';
          } else if (mainSession.dt < 5e-5 && meta.adaptive) {
            elEventBadge.textContent = '超近接遭遇中';
            elEventBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-medium truncate';
          } else if (mainSession.simTime >= 60.0) {
            elEventBadge.textContent = 'm₁脱出・連星分離';
            elEventBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-medium truncate';
          } else if (isRunning) {
            elEventBadge.textContent = '積分進行中';
            elEventBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-300 font-medium truncate';
          } else {
            elEventBadge.textContent = '一時停止中';
            elEventBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-slate-700/60 text-slate-300 font-medium truncate';
          }
        }

        // ==========================================
        // 10. メインアニメーションループ
        // ==========================================
        function animate() {
          try {
            if (isRunning) {
              const targetTime = mainSession.simTime + speedPerFrame;
              let subSteps = 0;
              const maxSubStepsPerFrame = 60000;
              const frameStartTime = performance.now();

              while (mainSession.simTime < targetTime && subSteps < maxSubStepsPerFrame) {
                const remaining = targetTime - mainSession.simTime;
                const advanced = stepSession(mainSession, remaining);
                if (advanced <= 0 || !Number.isFinite(mainSession.state[0])) {
                  setRunningState(false);
                  break;
                }
                subSteps++;
                if (subSteps % 4 === 0 || mainSession.simTime >= targetTime) {
                  recordTrailPoint();
                }
                if (subSteps % 1000 === 0 && performance.now() - frameStartTime > 15) {
                  break;
                }
              }
              updateAutoCamera(false);
              updateTelemetry();
            }
            render();
          } catch (err) {
            setRunningState(false);
            reportError(err);
          }
          requestAnimationFrame(animate);
        }

        // ==========================================
        // 11. パン・ズーム操作
        // ==========================================
        let isDragging = false;
        let lastPointerX = 0;
        let lastPointerY = 0;
        let initialPinchDist = null;
        let initialPinchScale = view.scale;

        function applyZoom(zoomFactor, pivotScreenX, pivotScreenY) {
          const newScale = Math.min(2000.0, Math.max(1.5, view.scale * zoomFactor));
          const worldXBefore = view.centerX + (pivotScreenX - cssWidth * 0.5) / view.scale;
          const worldYBefore = view.centerY - (pivotScreenY - cssHeight * 0.5) / view.scale;
          view.scale = newScale;
          view.centerX = worldXBefore - (pivotScreenX - cssWidth * 0.5) / view.scale;
          view.centerY = worldYBefore + (pivotScreenY - cssHeight * 0.5) / view.scale;
          render();
        }

        function getTouchDistance(t1, t2) {
          return Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
        }

        function disableAutoZoom() {
          if (autoZoom) {
            autoZoom = false;
            updateAutoZoomButton();
          }
        }

        canvas.addEventListener('mousedown', (e) => {
          disableAutoZoom();
          isDragging = true;
          lastPointerX = e.clientX;
          lastPointerY = e.clientY;
        });

        window.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          const dx = e.clientX - lastPointerX;
          const dy = e.clientY - lastPointerY;
          view.centerX -= dx / view.scale;
          view.centerY += dy / view.scale;
          lastPointerX = e.clientX;
          lastPointerY = e.clientY;
          render();
        });

        window.addEventListener('mouseup', () => {
          isDragging = false;
        });

        canvas.addEventListener('wheel', (e) => {
          e.preventDefault();
          disableAutoZoom();
          const zoomFactor = e.deltaY < 0 ? 1.15 : 0.87;
          applyZoom(zoomFactor, e.offsetX, e.offsetY);
        }, { passive: false });

        canvas.addEventListener('touchstart', (e) => {
          disableAutoZoom();
          if (e.touches.length === 1) {
            isDragging = true;
            lastPointerX = e.touches[0].clientX;
            lastPointerY = e.touches[0].clientY;
            initialPinchDist = null;
          } else if (e.touches.length === 2) {
            isDragging = false;
            initialPinchDist = getTouchDistance(e.touches[0], e.touches[1]);
            initialPinchScale = view.scale;
          }
        }, { passive: false });

        canvas.addEventListener('touchmove', (e) => {
          e.preventDefault();
          if (e.touches.length === 1 && isDragging) {
            const dx = e.touches[0].clientX - lastPointerX;
            const dy = e.touches[0].clientY - lastPointerY;
            view.centerX -= dx / view.scale;
            view.centerY += dy / view.scale;
            lastPointerX = e.touches[0].clientX;
            lastPointerY = e.touches[0].clientY;
            render();
          } else if (e.touches.length === 2 && initialPinchDist) {
            const currentDist = getTouchDistance(e.touches[0], e.touches[1]);
            const targetScale = Math.min(2000.0, Math.max(1.5, initialPinchScale * (currentDist / initialPinchDist)));
            const zoomFactor = targetScale / view.scale;
            const rect = canvas.getBoundingClientRect();
            const midX = ((e.touches[0].clientX + e.touches[1].clientX) * 0.5) - rect.left;
            const midY = ((e.touches[0].clientY + e.touches[1].clientY) * 0.5) - rect.top;
            applyZoom(zoomFactor, midX, midY);
          }
        }, { passive: false });

        canvas.addEventListener('touchend', (e) => {
          if (e.touches.length === 0) {
            isDragging = false;
            initialPinchDist = null;
          } else if (e.touches.length === 1) {
            isDragging = true;
            lastPointerX = e.touches[0].clientX;
            lastPointerY = e.touches[0].clientY;
            initialPinchDist = null;
          }
        });

        // ==========================================
        // 12. コントロールバインド
        // ==========================================
        const btnPlayPause = document.getElementById('btn-play-pause');
        const iconPlay = document.getElementById('icon-play');
        const iconPause = document.getElementById('icon-pause');
        const labelPlayPause = document.getElementById('label-play-pause');
        const statusLed = document.getElementById('status-led');

        function setRunningState(running) {
          isRunning = running;
          if (isRunning) {
            iconPlay.classList.add('hidden');
            iconPause.classList.remove('hidden');
            labelPlayPause.textContent = '停止';
            btnPlayPause.className = 'col-span-1 py-2 px-2 rounded-xl font-semibold text-xs sm:text-sm bg-amber-400 hover:bg-amber-300 active:scale-[0.98] text-slate-950 shadow-lg shadow-amber-500/20 transition flex items-center justify-center gap-1';
            statusLed.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shrink-0';
          } else {
            iconPlay.classList.remove('hidden');
            iconPause.classList.add('hidden');
            labelPlayPause.textContent = '再生';
            btnPlayPause.className = 'col-span-1 py-2 px-2 rounded-xl font-semibold text-xs sm:text-sm bg-sky-500 hover:bg-sky-400 active:scale-[0.98] text-slate-950 shadow-lg shadow-sky-500/20 transition flex items-center justify-center gap-1';
            statusLed.className = 'w-2.5 h-2.5 rounded-full bg-slate-500 shrink-0';
          }
          updateTelemetry();
        }

        btnPlayPause.addEventListener('click', () => {
          setRunningState(!isRunning);
        });

        function resetMainSimulation(keepRunning = false) {
          const schemeId = document.getElementById('select-scheme').value;
          const tolVal = parseFloat(document.getElementById('select-tol').value);
          nfeCount = 0;
          mainSession = createSolverSession(schemeId, tolVal);
          trails = [[], [], []];
          recordTrailPoint();
          setRunningState(keepRunning);
          updateSchemeUIHints();
          updateTelemetry();
          render();
        }

        const selectScheme = document.getElementById('select-scheme');
        const selectTol = document.getElementById('select-tol');
        const canvasSchemeBadge = document.getElementById('canvas-scheme-badge');
        const schemeTypeHint = document.getElementById('scheme-type-hint');
        const tolStatusHint = document.getElementById('tol-status-hint');

        function updateSchemeUIHints() {
          const meta = SCHEMES[selectScheme.value];
          canvasSchemeBadge.textContent = meta.name;
          schemeTypeHint.textContent = meta.type;
          if (meta.adaptive) {
            selectTol.disabled = false;
            selectTol.classList.remove('opacity-50');
            tolStatusHint.textContent = '適応刻み制御有効';
          } else {
            selectTol.disabled = true;
            selectTol.classList.add('opacity-50');
            tolStatusHint.textContent = '固定刻み法 (tol非使用)';
          }
        }

        selectScheme.addEventListener('change', () => {
          resetMainSimulation(true);
          autoZoom = true;
          updateAutoZoomButton();
          view.centerX = 0.0;
          view.centerY = 0.4;
          view.scale = Math.min(cssWidth, cssHeight) / 7.5;
        });

        selectTol.addEventListener('change', () => {
          mainSession.tol = parseFloat(selectTol.value);
        });

        document.getElementById('btn-reset-sim').addEventListener('click', () => {
          resetMainSimulation(false);
          autoZoom = true;
          updateAutoZoomButton();
          view.centerX = 0.0;
          view.centerY = 0.4;
          view.scale = Math.min(cssWidth, cssHeight) / 7.5;
          render();
        });

        const btnAutoZoom = document.getElementById('btn-auto-zoom');
        const dotAutoZoom = document.getElementById('dot-auto-zoom');
        function updateAutoZoomButton() {
          if (autoZoom) {
            btnAutoZoom.className = 'bg-sky-500/20 hover:bg-sky-500/30 active:scale-95 backdrop-blur-sm text-sky-300 text-xs px-2.5 py-1.5 rounded-xl border border-sky-500/40 shadow transition flex items-center gap-1';
            dotAutoZoom.className = 'w-2 h-2 rounded-full bg-sky-400';
          } else {
            btnAutoZoom.className = 'bg-space-900/85 hover:bg-slate-800 active:scale-95 backdrop-blur-sm text-slate-400 text-xs px-2.5 py-1.5 rounded-xl border border-slate-700/80 shadow transition flex items-center gap-1';
            dotAutoZoom.className = 'w-2 h-2 rounded-full bg-slate-500';
          }
        }

        btnAutoZoom.addEventListener('click', () => {
          autoZoom = !autoZoom;
          updateAutoZoomButton();
          if (autoZoom) {
            updateAutoCamera(true);
            render();
          }
        });

        document.getElementById('btn-reset-view').addEventListener('click', () => {
          disableAutoZoom();
          view.centerX = 0.0;
          view.centerY = 0.4;
          view.scale = Math.min(cssWidth, cssHeight) / 7.5;
          render();
        });

        // 時刻ジャンプボタン
        document.querySelectorAll('.btn-jump').forEach((btn) => {
          btn.addEventListener('click', () => {
            const targetT = parseFloat(btn.getAttribute('data-jump'));
            resetMainSimulation(false);

            let guard = 0;
            const maxSteps = 800000;
            while (mainSession.simTime < targetT && guard < maxSteps) {
              const adv = stepSession(mainSession, targetT - mainSession.simTime);
              if (adv <= 0 || !Number.isFinite(mainSession.state[0])) break;
              guard++;
              if (guard % 8 === 0 || mainSession.simTime >= targetT) {
                recordTrailPoint();
              }
            }

            autoZoom = true;
            updateAutoZoomButton();
            updateAutoCamera(true);
            updateTelemetry();
            render();
          });
        });

        const btnTrailMode = document.getElementById('btn-trail-mode');
        const labelTrailMode = document.getElementById('label-trail-mode');
        const dotTrailMode = document.getElementById('dot-trail-mode');
        btnTrailMode.addEventListener('click', () => {
          fullTrailMode = !fullTrailMode;
          labelTrailMode.textContent = fullTrailMode ? '軌跡: 全履歴' : '軌跡: 短期表示';
          dotTrailMode.className = fullTrailMode ? 'w-2 h-2 rounded-full bg-emerald-400 shrink-0' : 'w-2 h-2 rounded-full bg-sky-400 shrink-0';
          if (!fullTrailMode) {
            for (let b = 0; b < 3; b++) {
              if (trails[b].length > SHORT_TRAIL_MAX) {
                trails[b] = trails[b].slice(-SHORT_TRAIL_MAX);
              }
            }
          }
          render();
        });

        const sliderSpeed = document.getElementById('slider-speed');
        const labelSpeed = document.getElementById('label-speed');
        sliderSpeed.addEventListener('input', (e) => {
          speedPerFrame = parseFloat(e.target.value);
          labelSpeed.textContent = speedPerFrame.toFixed(3);
        });

        // ==========================================
        // 13. ベンチマーク比較テーブル ＆ 一括計測ロジック
        // ==========================================
        const benchModal = document.getElementById('bench-modal');
        const benchTableBody = document.getElementById('bench-table-body');
        const benchProgressWrap = document.getElementById('bench-progress-wrap');
        const benchProgressLabel = document.getElementById('bench-progress-label');
        const benchProgressPct = document.getElementById('bench-progress-pct');
        const benchProgressBar = document.getElementById('bench-progress-bar');

        let benchmarkRecords = [];
        let isBatchRunning = false;

        function renderBenchmarkTable() {
          if (benchmarkRecords.length === 0) {
            benchTableBody.innerHTML = `
              <tr>
                <td colspan="7" class="py-8 text-center font-sans text-slate-400">
                  「全10スキーム一括計測を実行」を押すか，メイン画面の「+ 結果記録」で現在の計算結果を追加してください．
                </td>
              </tr>`;
            return;
          }

          benchTableBody.innerHTML = benchmarkRecords.map((rec) => {
            const eErrStr = Number.isFinite(rec.energyErr) ? rec.energyErr.toExponential(2) : '発散';
            const posErrStr = rec.posErr === null
              ? '—'
              : (Number.isFinite(rec.posErr) ? rec.posErr.toExponential(2) : '発散');

            const isHighAccuracy = Number.isFinite(rec.energyErr) && rec.energyErr < 1e-9;
            const rowClass = rec.isRef
              ? 'bg-sky-500/10'
              : (isHighAccuracy ? 'hover:bg-slate-800/50' : 'bg-rose-950/15 hover:bg-slate-800/50');

            return `
              <tr class="${rowClass} transition">
                <td class="py-2 px-2.5 font-sans font-medium text-slate-100">
                  ${rec.name}
                  ${rec.tag ? `<span class="ml-1 text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-300">${rec.tag}</span>` : ''}
                </td>
                <td class="py-2 px-2 text-center text-amber-300 font-bold">${rec.order}次</td>
                <td class="py-2 px-2 text-right text-slate-300">${rec.t.toFixed(2)}</td>
                <td class="py-2 px-2.5 text-right text-emerald-400 font-bold">${rec.nfe.toLocaleString()}</td>
                <td class="py-2 px-2.5 text-right text-cyan-300">${eErrStr}</td>
                <td class="py-2 px-2.5 text-right text-amber-200">${posErrStr}</td>
                <td class="py-2 px-2 text-right text-slate-400">${rec.ms !== null ? rec.ms.toFixed(1) + ' ms' : '手動記録'}</td>
              </tr>`;
          }).join('');
        }

        // 手動スナップショット記録
        document.getElementById('btn-record-snapshot').addEventListener('click', () => {
          const meta = SCHEMES[mainSession.schemeId];
          const currE = computeTotalEnergy(mainSession.state);
          const relErr = Math.abs(currE - E0) / Math.abs(E0);

          benchmarkRecords.unshift({
            name: meta.short,
            tag: meta.adaptive ? `tol=${mainSession.tol.toExponential(0)}` : '固定刻み',
            order: meta.order,
            t: mainSession.simTime,
            nfe: nfeCount,
            energyErr: relErr,
            posErr: null,
            ms: null,
            isRef: false
          });
          renderBenchmarkTable();
          benchModal.classList.remove('hidden');
        });

        // 特定スキームを指定時刻 targetT まで独立して走らせるヘルパー
        function integrateSchemeToTarget(schemeId, tolVal, targetT) {
          const savedNfe = nfeCount;
          nfeCount = 0;
          const sess = createSolverSession(schemeId, tolVal);
          const t0 = performance.now();

          let guard = 0;
          const maxSteps = 1200000;
          while (sess.simTime < targetT && guard < maxSteps) {
            const adv = stepSession(sess, targetT - sess.simTime);
            if (adv <= 0 || !Number.isFinite(sess.state[0])) break;
            guard++;
          }

          const elapsedMs = performance.now() - t0;
          const usedNfe = nfeCount;
          nfeCount = savedNfe; // メイン画面のカウンタを復元

          const currE = computeTotalEnergy(sess.state);
          const relErr = Math.abs(currE - E0) / Math.abs(E0);

          return {
            state: sess.state,
            simTime: sess.simTime,
            nfe: usedNfe,
            energyErr: relErr,
            ms: elapsedMs
          };
        }

        function computePositionL2Error(stateA, stateB) {
          let sumSq = 0.0;
          for (let i = 0; i < 6; i++) {
            const d = stateA[i] - stateB[i];
            if (!Number.isFinite(d)) return Infinity;
            sumSq += d * d;
          }
          return Math.sqrt(sumSq);
        }

        // 全10スキーム一括ベンチマーク実行（UIフリーズ防止のチャンク非同期実行）
        document.getElementById('btn-run-batch-bench').addEventListener('click', () => {
          if (isBatchRunning) return;
          isBatchRunning = true;
          setRunningState(false);

          const targetT = parseFloat(document.getElementById('bench-target-t').value);
          const benchTol = parseFloat(document.getElementById('bench-tol').value);
          const schemeKeys = Object.keys(SCHEMES);

          benchProgressWrap.classList.remove('hidden');
          benchProgressLabel.textContent = '13次 GBS外挿法 (tol=1e-13) で厳密参照解を計算中...';
          benchProgressPct.textContent = '5%';
          benchProgressBar.style.width = '5%';

          setTimeout(() => {
            try {
              // Step 0: 13次 GBS-13 (tol=1e-13) による厳密参照解の生成
              const refRes = integrateSchemeToTarget('gbs13', 1e-13, targetT);
              const results = [];

              let idx = 0;
              function runNextScheme() {
                if (idx >= schemeKeys.length) {
                  // 完了
                  benchmarkRecords = results;
                  renderBenchmarkTable();
                  benchProgressWrap.classList.add('hidden');
                  isBatchRunning = false;
                  return;
                }

                const key = schemeKeys[idx];
                const meta = SCHEMES[key];
                const pct = Math.round(((idx + 1) / (schemeKeys.length + 1)) * 100);
                benchProgressLabel.textContent = `計測中 (${idx + 1}/10): ${meta.name}`;
                benchProgressPct.textContent = `${pct}%`;
                benchProgressBar.style.width = `${pct}%`;

                setTimeout(() => {
                  try {
                    const res = integrateSchemeToTarget(key, benchTol, targetT);
                    const posErr = computePositionL2Error(res.state, refRes.state);
                    results.push({
                      name: meta.short,
                      tag: meta.adaptive ? `tol=${benchTol.toExponential(0)}` : `h=${meta.fixedDt}`,
                      order: meta.order,
                      t: res.simTime,
                      nfe: res.nfe,
                      energyErr: res.energyErr,
                      posErr: posErr,
                      ms: res.ms,
                      isRef: key === 'gbs13'
                    });
                    idx++;
                    runNextScheme();
                  } catch (e) {
                    isBatchRunning = false;
                    benchProgressWrap.classList.add('hidden');
                    reportError(e);
                  }
                }, 16);
              }

              runNextScheme();
            } catch (e) {
              isBatchRunning = false;
              benchProgressWrap.classList.add('hidden');
              reportError(e);
            }
          }, 25);
        });

        document.getElementById('btn-clear-bench').addEventListener('click', () => {
          benchmarkRecords = [];
          renderBenchmarkTable();
        });

        // ベンチマークモーダル開閉
        document.getElementById('btn-open-bench').addEventListener('click', () => {
          benchModal.classList.remove('hidden');
        });
        document.getElementById('btn-close-bench').addEventListener('click', () => {
          benchModal.classList.add('hidden');
        });
        document.getElementById('btn-close-bench-footer').addEventListener('click', () => {
          benchModal.classList.add('hidden');
        });
        benchModal.addEventListener('click', (e) => {
          if (e.target === benchModal) benchModal.classList.add('hidden');
        });

        // 数理解説モーダル開閉
        const mathModal = document.getElementById('math-modal');
        document.getElementById('btn-open-modal').addEventListener('click', () => {
          mathModal.classList.remove('hidden');
        });
        document.getElementById('btn-close-modal').addEventListener('click', () => {
          mathModal.classList.add('hidden');
        });
        document.getElementById('btn-close-modal-footer').addEventListener('click', () => {
          mathModal.classList.add('hidden');
        });
        mathModal.addEventListener('click', (e) => {
          if (e.target === mathModal) mathModal.classList.add('hidden');
        });

        // ==========================================
        // 14. 初期化および描画ループ開始
        // ==========================================
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        view.scale = Math.min(cssWidth, cssHeight) / 7.5;
        updateSchemeUIHints();
        recordTrailPoint();
        setRunningState(true);
        requestAnimationFrame(animate);

      } catch (err) {
        reportError(err);
      }
    });
  </script>
</body>
</html>
