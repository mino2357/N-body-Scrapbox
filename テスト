            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- ベンチマーク操作バー -->
      <div class="px-4 py-2.5 bg-space-950/40 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2">
          <label for="bench-target-t" class="text-xs text-slate-300 font-medium">到達時刻:</label>
          <select id="bench-target-t" class="bg-slate-800 border border-slate-700 text-slate-100 text-xs rounded-lg px-2 py-1.5 font-mono">
            <option value="20.0">t = 20.0 (第1近接通過後)</option>
            <option value="45.0">t = 45.0 (多重近接カオス領域)</option>
            <option value="65.0" selected>t = 65.0 (m₁脱出・連星分離後)</option>
          </select>

          <label for="bench-tol" class="text-xs text-slate-300 font-medium">適応tol:</label>
          <select id="bench-tol" class="bg-slate-800 border border-slate-700 text-slate-100 text-xs rounded-lg px-2 py-1.5 font-mono">
            <option value="1e-8">1e-8</option>
            <option value="1e-10" selected>1e-10</option>
            <option value="1e-12">1e-12</option>
