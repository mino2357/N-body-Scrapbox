            <span id="dot-auto-zoom" class="w-2 h-2 rounded-full bg-sky-400"></span>
            <span>オートズーム</span>
          </button>
          <button id="btn-reset-view" type="button"
            class="bg-space-900/85 hover:bg-slate-800 active:scale-95 backdrop-blur-sm text-slate-200 text-xs px-2.5 py-1.5 rounded-xl border border-slate-700/80 shadow transition flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
