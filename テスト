          5次: Dormand-Prince 5(4) [DOPRI5]
        </div>
      </div>
    </section>

    <!-- コントロールパネル -->
    <section aria-label="操作パネル" class="bg-space-900 border border-slate-800 rounded-2xl p-3 flex flex-col gap-2.5">
